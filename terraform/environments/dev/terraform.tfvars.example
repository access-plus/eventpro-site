# Dev Environment - Terraform Variables Example
# Copy this file to terraform.tfvars and fill in the actual values
# DO NOT commit terraform.tfvars to version control

environment = "dev"
name_prefix = "eventpro-dev"
aws_region  = "us-east-1"

# Route53 Configuration
route53_zone_name = "example.com."  # Your existing Route53 hosted zone name (must end with .)
route53_private_zone = false
domain_name = "example.com"  # Your domain name without trailing dot

frontend_subdomain = "app"
api_subdomain = "api"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# RDS Configuration
db_instance_class = "db.t3.medium"  # Use db.t3.micro for dev to save costs
db_username       = "eventpro_admin"  # Change this
db_password       = "CHANGE_ME_STRONG_PASSWORD"  # Change this - use a strong password
db_name          = "eventprodb"
db_multi_az      = false  # Set to false for dev to save costs

# ECS Configuration (Modular Monolith)
eventpro_api_image = "eventpro-api:latest"  # Update with your actual image
ecs_desired_count  = 2  # Start with 2 for HA
ecs_task_cpu       = 1024  # 1 vCPU
ecs_task_memory    = 2048  # 2GB RAM

# Auto-scaling Configuration
ecs_enable_auto_scaling        = true
ecs_autoscaling_min_capacity   = 2
ecs_autoscaling_max_capacity   = 10
ecs_autoscaling_cpu_target_value    = 70.0
ecs_autoscaling_memory_target_value = 80.0

# ALB Configuration
alb_certificate_arn = null  # Set to ACM certificate ARN if you have one (must be in us-east-1)
alb_internal        = false

# CloudFront Configuration
cloudfront_certificate_arn = null  # Set to ACM certificate ARN if you have one (must be in us-east-1)

# Cognito Configuration
cognito_domain        = "eventpro-dev-auth"  # Optional: Cognito domain prefix
cognito_certificate_arn = null  # Set to ACM certificate ARN for custom domain (must be in us-east-1)

# Secrets Manager Configuration
stripe_secret_key      = ""  # Your Stripe secret key (sk_test_... for dev)
stripe_publishable_key = ""  # Your Stripe publishable key (pk_test_... for dev)
jwt_secret             = ""  # JWT secret key for token signing (generate a strong random string)

# Analytics Service Lambda (Optional - remains as serverless)
# analytics_service_image = "eventpro/analytics-service:latest"

# Tags
tags = {
  Environment = "dev"
  Project     = "eventpro"
  ManagedBy   = "terraform"
  Owner       = "devops-team"
}

