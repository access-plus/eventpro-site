{
  "openapi": "3.0.3",
  "info": {
    "title": "EventPro Platform API",
    "version": "1.0.0",
    "description": "REST API for EventPro event ticketing platform",
    "contact": {
      "name": "EventPro Team"
    }
  },
  "servers": [
    {
      "url": "https://api.eventpro.com/api/v1",
      "description": "Production server"
    },
    {
      "url": "http://localhost:8080/api/v1",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "AWS Cognito JWT token"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "email", "firstName", "lastName"]
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "marketingEnabled": {
            "type": "boolean",
            "default": false
          },
          "organizer": {
            "$ref": "#/components/schemas/User"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "name", "startTime", "endTime"]
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["id", "name"]
      },
      "Address": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "street": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "zipCode": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "nullable": true
          }
        },
        "required": ["id", "street", "city", "state", "zipCode", "country"]
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "decimal"
          },
          "ticketType": {
            "type": "string",
            "enum": ["VIP", "REGULAR", "EARLY_BIRD"]
          },
          "ticketStatus": {
            "type": "string",
            "enum": ["AVAILABLE", "SOLD", "RESERVED"]
          },
          "startTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "qrCode": {
            "type": "string",
            "nullable": true
          },
          "printOutUrl": {
            "type": "string",
            "nullable": true
          },
          "event": {
            "$ref": "#/components/schemas/Event"
          }
        },
        "required": ["id", "name", "price", "ticketType", "ticketStatus"]
      },
      "CartItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "ticket": {
            "$ref": "#/components/schemas/Ticket"
          }
        },
        "required": ["id", "quantity", "ticket"]
      },
      "Cart": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItem"
            }
          },
          "total": {
            "type": "number",
            "format": "decimal"
          }
        },
        "required": ["items", "total"]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orderNumber": {
            "type": "string"
          },
          "totalAmount": {
            "type": "number",
            "format": "decimal"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "PAID", "CANCELLED", "REFUNDED"]
          },
          "orderDate": {
            "type": "string",
            "format": "date-time"
          },
          "orderItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": ["id", "orderNumber", "totalAmount", "status", "orderDate"]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "price": {
            "type": "number",
            "format": "decimal"
          },
          "ticket": {
            "$ref": "#/components/schemas/Ticket"
          }
        },
        "required": ["id", "quantity", "price"]
      },
      "Payment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "paymentMethod": {
            "type": "string"
          },
          "transactionId": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "SUCCESS", "FAILED", "REFUNDED"]
          },
          "paymentDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": ["id", "amount", "paymentMethod", "status"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["error", "message", "timestamp"]
      }
    }
  },
  "paths": {
    "/users/me": {
      "get": {
        "summary": "Get current user profile",
        "tags": ["Users"],
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update current user profile",
        "tags": ["Users"],
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {"type": "string"},
                  "lastName": {"type": "string"},
                  "phoneNumber": {"type": "string", "nullable": true}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "summary": "Get user by ID (admin only)",
        "tags": ["Users"],
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Admin role required"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "List all users (admin only)",
        "tags": ["Users"],
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {"type": "integer", "default": 0, "minimum": 0}
          },
          {
            "name": "size",
            "in": "query",
            "schema": {"type": "integer", "default": 20, "minimum": 1, "maximum": 100}
          }
        ],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "array",
                      "items": {"$ref": "#/components/schemas/User"}
                    },
                    "totalElements": {"type": "integer"},
                    "totalPages": {"type": "integer"},
                    "page": {"type": "integer"},
                    "size": {"type": "integer"}
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Admin role required"
          }
        }
      }
    },
    "/events": {
      "get": {
        "summary": "List all events",
        "tags": ["Events"],
        "parameters": [
          {
            "name": "categoryId",
            "in": "query",
            "schema": {"type": "string", "format": "uuid"}
          },
          {
            "name": "search",
            "in": "query",
            "schema": {"type": "string"}
          },
          {
            "name": "page",
            "in": "query",
            "schema": {"type": "integer", "default": 0}
          },
          {
            "name": "size",
            "in": "query",
            "schema": {"type": "integer", "default": 20}
          }
        ],
        "responses": {
          "200": {
            "description": "List of events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "array",
                      "items": {"$ref": "#/components/schemas/Event"}
                    },
                    "totalElements": {"type": "integer"},
                    "totalPages": {"type": "integer"}
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create event (admin/organizer only)",
        "tags": ["Events"],
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {"type": "string"},
                  "description": {"type": "string"},
                  "startTime": {"type": "string", "format": "date-time"},
                  "endTime": {"type": "string", "format": "date-time"},
                  "categoryId": {"type": "string", "format": "uuid"},
                  "address": {
                    "type": "object",
                    "properties": {
                      "street": {"type": "string"},
                      "city": {"type": "string"},
                      "state": {"type": "string"},
                      "zipCode": {"type": "string"},
                      "country": {"type": "string"},
                      "latitude": {"type": "number"},
                      "longitude": {"type": "number"}
                    },
                    "required": ["street", "city", "state", "zipCode", "country"]
                  },
                  "marketingEnabled": {"type": "boolean", "default": false}
                },
                "required": ["name", "startTime", "endTime", "categoryId", "address"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "403": {
            "description": "Forbidden - Admin/Organizer role required"
          }
        }
      }
    },
    "/events/{id}": {
      "get": {
        "summary": "Get event by ID",
        "tags": ["Events"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "200": {
            "description": "Event details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "404": {
            "description": "Event not found"
          }
        }
      },
      "patch": {
        "summary": "Update event (admin/organizer only)",
        "tags": ["Events"],
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {"type": "string"},
                  "description": {"type": "string"},
                  "startTime": {"type": "string", "format": "date-time"},
                  "endTime": {"type": "string", "format": "date-time"},
                  "marketingEnabled": {"type": "boolean"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Event not found"
          }
        }
      },
      "delete": {
        "summary": "Delete event (admin/organizer only)",
        "tags": ["Events"],
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "204": {
            "description": "Event deleted"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Event not found"
          }
        }
      }
    },
    "/events/category/{categoryId}": {
      "get": {
        "summary": "Get events by category",
        "tags": ["Events"],
        "parameters": [
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "200": {
            "description": "List of events in category",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/Event"}
                }
              }
            }
          }
        }
      }
    },
    "/tickets": {
      "post": {
        "summary": "Create tickets (admin/organizer only)",
        "tags": ["Tickets"],
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "eventId": {"type": "string", "format": "uuid"},
                  "tickets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {"type": "string"},
                        "price": {"type": "number"},
                        "ticketType": {"type": "string", "enum": ["VIP", "REGULAR", "EARLY_BIRD"]},
                        "quantity": {"type": "integer", "minimum": 1},
                        "startTime": {"type": "string", "format": "date-time"},
                        "endTime": {"type": "string", "format": "date-time"}
                      },
                      "required": ["name", "price", "ticketType", "quantity"]
                    }
                  }
                },
                "required": ["eventId", "tickets"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tickets created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/Ticket"}
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/tickets/{id}": {
      "get": {
        "summary": "Get ticket by ID",
        "tags": ["Tickets"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "404": {
            "description": "Ticket not found"
          }
        }
      },
      "patch": {
        "summary": "Update ticket (admin/organizer only)",
        "tags": ["Tickets"],
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {"type": "string"},
                  "price": {"type": "number"},
                  "ticketType": {"type": "string", "enum": ["VIP", "REGULAR", "EARLY_BIRD"]}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket updated"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Ticket not found"
          }
        }
      },
      "delete": {
        "summary": "Delete ticket (admin/organizer only)",
        "tags": ["Tickets"],
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "204": {
            "description": "Ticket deleted"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/tickets/event/{eventId}": {
      "get": {
        "summary": "Get tickets by event",
        "tags": ["Tickets"],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "200": {
            "description": "List of tickets for event",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/Ticket"}
                }
              }
            }
          }
        }
      }
    },
    "/cart": {
      "get": {
        "summary": "Get user's cart",
        "tags": ["Cart"],
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "User's shopping cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/cart/add": {
      "post": {
        "summary": "Add item to cart",
        "tags": ["Cart"],
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ticketId": {"type": "string", "format": "uuid"},
                  "quantity": {"type": "integer", "minimum": 1}
                },
                "required": ["ticketId", "quantity"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item added to cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartItem"
                }
              }
            }
          },
          "400": {
            "description": "Bad request (ticket unavailable, invalid quantity)"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/cart/update": {
      "patch": {
        "summary": "Update cart item quantity",
        "tags": ["Cart"],
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "itemId": {"type": "string", "format": "uuid"},
                  "quantity": {"type": "integer", "minimum": 1}
                },
                "required": ["itemId", "quantity"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cart item updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartItem"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "404": {
            "description": "Cart item not found"
          }
        }
      }
    },
    "/cart/delete/{itemId}": {
      "delete": {
        "summary": "Remove item from cart",
        "tags": ["Cart"],
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
