# Multi-stage Dockerfile for Quarkus Order Processor Lambda (Native)
# This builds a native executable container image for AWS Lambda
# Note: Native builds require Docker-in-Docker or a build environment with GraalVM

# Build stage with GraalVM (native-image pre-installed)
FROM ghcr.io/graalvm/native-image-community:25 AS build
WORKDIR /app

# Copy Gradle wrapper and build files
COPY gradlew .
COPY gradle ./gradle
COPY build.gradle settings.gradle ./

# Make gradlew executable
RUN chmod +x gradlew

# Copy source code
COPY src ./src

# Build native executable
RUN ./gradlew build -Dquarkus.package.type=native --no-daemon -x test

# Runtime stage - Use AWS Lambda provided runtime
FROM public.ecr.aws/lambda/provided:al2

# Copy the native executable
COPY --from=build /app/build/*-runner /var/runtime/bootstrap

# Make executable
RUN chmod 755 /var/runtime/bootstrap

# Set the handler
CMD ["io.quarkus.amazon.lambda.runtime.QuarkusStreamHandler::handleRequest"]

